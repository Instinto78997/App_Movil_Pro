{
  "expo": {
    "name": "restaurante-app",
    "slug": "restaurante-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "restauranteapp",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D1F23",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.restaurante.app",
      "infoPlist": {
        "NSCameraUsageDescription": "La cámara se usa para registrar la foto de perfil y verificar tu identidad."
      }
    },
    "android": {
      "package": "com.restaurante.app",
      "permissions": ["android.permission.CAMERA", "android.permission.INTERNET"],
      "adaptiveIcon": {
        "backgroundColor": "#0D1F23",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1F23",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Permite usar la cámara para tomar tu foto de perfil.",
          "photosPermission": "Permite seleccionar una foto de perfil desde tu galería.",
          "microphonePermission": false
        }
      ],
      [
        "@blacktomang/expo-aws-liveness",
        {
          "cameraPermission": "Permite usar la cámara para verificar tu identidad."
        }
      ],
      "./plugins/with-android-liveness-workaround.js"
    ],
    "extra": {
      "awsIdentityPoolId": "us-east-1:d0fb2822-8d57-4c1f-8f02-034bf905a586"
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
